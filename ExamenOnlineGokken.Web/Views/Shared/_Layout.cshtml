<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - [JE NAAM EN VOORNAAM]</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
</head>
<body>
    <div class="container" id="appContainer">
        <header class="row">
            <h1 class="col">Better Online Bets</h1>
        </header>
        <nav>
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="/">All Games</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link " href="/ByLeague">By League</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link " href="/Home/Search">Search</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link " href="/Books/Create">Add Game</a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Bet" asp-action="ShowBets" class="btn btn-info btn-sm">
                        <span class="fas fa-shopping-cart"></span> Your Bets: 0
                    </a>
                </li>
            </ul>
        </nav>
        <div class="row mt-5">
            <aside class="col-4">
                <h3>Leagues</h3>
                <div class="list-group">
                    <a class="list-group-item list-group-item-action " href="/ByLeague/0">Leagues</a>
                    <a class="list-group-item list-group-item-action " href="/ByLeague/0">Go here</a>
                    <a class="list-group-item list-group-item-action " href="/ByLeague/0">...</a>
                </div>
            </aside>
            <main class="col-8">
                @RenderBody()
            </main>
        </div>
    </div>
</body>
</html>
