@model IEnumerable<Game>

<table class="table mt-5" id="games-table">
    <thead class="thead-light">
        <tr>
            <th scope="col">Home</th>
            <th scope="col">Away</th>
            <th scope="col">Date</th>
            <th scope="col">N° of Bets</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var game in Model)
        {
            <tr>
                <td>@game.AwayTeam</td>
                <td>@game.Hometeam</td>
                <td>@game.DateOfGame</td>
            <td><span class="badge bg-info text-white">@game.Bets.Count.ToString()</span></td>
            <td>
                <form asp-controller="Bet" asp-action="Add" method="post" class="d-inline">
                    <input type="hidden" name="gameId" value="@game.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">Bet</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
    <tfoot>
    <th colspan="4"></th>
    </tfoot>
</table>
