@model SearchGameViewModel

<h4>Search</h4>

<form asp-controller="Home" asp-action="Search" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="HomeTeam"></label>
        <input asp-for="HomeTeam" class="form-control" />
        <span asp-validation-for="HomeTeam" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AwayTeam"></label>
        <input asp-for="AwayTeam" class="form-control" />
        <span asp-validation-for="AwayTeam" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="SelectedLeagueId"></label>
        <select asp-for="SelectedLeagueId" asp-items="Model.Leagues" class="form-control"></select>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Search</button>
</form>

@if (Model.Games != null)
{
    <partial name="_GameListPartial" model="Model.Games" />
}
